    "Lummi couldn't open its storage. Your joys haven't been deleted. Try again, or restart the app." : {
      "comment" : "The explanation on the storage error screen. Reassures the user that nothing was deleted.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lummi konnte seinen Speicher nicht öffnen. Deine Momente wurden nicht gelöscht. Versuche es erneut oder starte die App neu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lummi не удалось открыть своё хранилище. Ваши моменты не удалены. Повторите попытку или перезапустите приложение."
          }
        }
      }
    },
    "Lummi couldn't use iCloud sync. Your joys are safe on this device. Check your iCloud settings and try again later." : {
      "comment" : "The message of the iCloud sync error alert. Reassures the user that the joys are still stored on the device.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lummi konnte die iCloud-Synchronisierung nicht verwenden. Deine Momente sind auf diesem Gerät sicher. Prüfe deine iCloud-Einstellungen und versuche es später erneut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lummi не удалось использовать синхронизацию с iCloud. Ваши моменты в безопасности на этом устройстве. Проверьте настройки iCloud и повторите попытку позже."
          }
        }
      }
    },
